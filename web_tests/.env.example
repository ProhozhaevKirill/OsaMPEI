# Django
SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
DB_ENGINE=mysql
DB_NAME=osampei
DB_USER=osampei_app
DB_PASSWORD=replace-with-the-mysql-user-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Parallel background grading processes (1-8).
ATTEMPT_GRADING_WORKERS=2

# Yandex Disk OAuth token and application folder
YANDEX_DISK_TOKEN=replace-with-the-oauth-token
YANDEX_DISK_FOLDER=app:/test_logs
